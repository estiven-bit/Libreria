{
  "crons": [
    {
      "path": "/bff/health",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "storage/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.php"
    }
  ]
}
